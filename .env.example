# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env

# ── LLM (비워 두면 LLM 없이 '검색 결과만' 보는 모드로 실행) ─────────────
# 형식: <provider>:<model>
# 교과서 설정은 openai:gpt-4o + temperature 0. temperature 를 지원하는 최신 모델 예:
#   anthropic:claude-sonnet-4-6     (temperature 0 공식 지원, 권장)
#   google_genai:gemini-2.5-flash   (temperature 0 가능. Gemini 3 는 1.0 유지 권고)
#   openai:gpt-4.1                  (temperature 지원. GPT-5.x/6 계열은 추론 강도 none 일 때만)
# temperature 를 받지 않는 최신 모델(예: anthropic:claude-opus-5-5)을 쓸 때는 LLM_TEMPERATURE 를 비우세요.
LLM_MODEL=anthropic:claude-sonnet-4-6
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── 실습 03 그래프 추출 방식 ────────────────────────────────────────────
# custom : Pydantic 스키마 + with_structured_output (직접 구현)
# lgt    : LangChain LLMGraphTransformer (교과서 방식)
EXTRACTOR=custom

# ── 임베딩 ────────────────────────────────────────────────────────────
# local-ngram : 키/인터넷 없이 동작하는 간이 임베딩 (기본값, 데모용)
# huggingface:intfloat/multilingual-e5-small : 무료 로컬 모델 (한국어 OK, 첫 실행 시 다운로드)
# openai:text-embedding-3-small : OpenAI API
EMBEDDING_MODEL=local-ngram

# ── 실습 03 에서 LLM 으로 만든 그래프를 쓰고 싶다면 ────────────────────
# KG_FILE=kg_extracted.json

# ── 실습 07 Neo4j ─────────────────────────────────────────────────────
# (A) 로컬 Docker — docker-compose.yml 과 같은 값, 로컬 실습 전용 비밀번호
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphrag-lab-local
# (B) Neo4j AuraDB (교과서 방식) — 인스턴스 생성 시 내려받는 자격 증명 파일의 값을 넣고 (A)를 주석 처리
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
